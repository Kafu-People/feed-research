# Copy to .env for local development. Never commit .env.
TT_ENV=local
TT_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/techtrend
TT_REDIS_URL=redis://localhost:6379/0
TT_S3_BUCKET=techtrend-local
TT_S3_ENDPOINT=http://localhost:9000
TT_JWT_SECRET=dev-secret
TT_AI_FAKE=true
# Not TT_-prefixed: the Anthropic SDK reads this itself (or an `ant auth login` profile).
# ANTHROPIC_API_KEY=
