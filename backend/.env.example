# Copy to .env for local development. Never commit .env.
TT_ENV=local
TT_DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/techtrend
TT_REDIS_URL=redis://localhost:6379/0
TT_S3_BUCKET=techtrend-local
TT_S3_ENDPOINT=http://localhost:9000
TT_JWT_SECRET=dev-secret
TT_AI_FAKE=true
# Not TT_-prefixed: the Anthropic SDK reads this itself (or an `ant auth login` profile).
# ANTHROPIC_API_KEY=
# Through the shared AI gateway instead: ANTHROPIC_API_KEY is then the gateway token.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8090/anthropic

# --- slack delivery ---------------------------------------------------------
# Inert unless BOTH the token and the channel are set: with either missing, no
# notify job is ever enqueued and nothing is posted.
# Bot token from api.slack.com/apps -> OAuth & Permissions.
# Scopes: chat:write, chat:write.public (post without being invited),
#         channels:read, channels:manage (create the channel),
#         channels:history (find an existing summary reply to edit).
# TT_SLACK_BOT_TOKEN=xoxb-...
# Channel ID (C0...), not #name -- names break on rename. Refused at boot.
# TT_SLACK_CHANNEL=C0XXXXXXXXX

# Which topics reach Slack, by topic id. REMOVE THE LINE ENTIRELY for all
# topics -- an empty list means "no filter", not "nothing".
TT_SLACK_TOPIC_IDS=[1,3,13,17,18]

# Match score a story must clear to be posted. Measured 2026-08-20 on the live
# corpus: 0.5 ~= 50 stories/day, 0.6 ~= 28/day, 0.7 ~= 4/day.
TT_SLACK_MATCH_FLOOR=0.6

# Plain-language summary as a threaded reply under each card (one Haiku call
# per story, ~$1.20/month at 28/day). Set false to stop that spend entirely.
TT_SLACK_SUMMARIES=true

# Socket Mode app-level token, for the Q&A listener (techtrend-slackbot).
# Separate from the bot token: app settings -> Socket Mode -> generate, scope
# connections:write. Needed because there is no public HTTPS endpoint on this
# host for Slack's Events API to POST to; the WebSocket dials OUT instead.
# Also requires the app_mentions:read bot scope + the app_mention subscription.
# TT_SLACK_APP_TOKEN=xapp-...

# Per-topic floor overrides, keyed by topic id. Scores are not comparable
# across topics: the matcher reads title + description only, so a job listing
# with a boilerplate board description scores lower than a real headline even
# when both match well. Anything not listed uses TT_SLACK_MATCH_FLOOR.
#
# The startup/venture topics added 2026-09-07 want 0.55, measured over 120 days
# of live corpus plus one pull of the new feeds. "Startup funding & investors"
# is left at the global 0.6 -- it already yields 0.72 stories/day there and a
# random 35 of its matches read one false positive:
#
#   Startup ideas & founder playbooks   0.6: nothing from the news corpus at
#                                       all, 11 of 321 from HN and the founder
#                                       newsletters -- 0.55 takes that to 27
#   Market & sector analysis            0.6: 0.22/day  ->  0.55: 0.49/day
#
# Ids are whatever `seed-topics` assigns, so read them back before setting this
# (SELECT id, title FROM topics ORDER BY id) -- they follow 22 on a database
# seeded in order.
TT_SLACK_TOPIC_FLOORS={"18": 0.5}

# --- daily research briefs (Gemini + Google Search grounding) ---------------
# Inert unless BOTH the key and the channel are set, the same rule the Slack
# card path uses: a key with no channel researches into the void.
# GEMINI_API_KEY=...
# Through the shared AI gateway instead: GEMINI_API_KEY is then the gateway token.
# TT_GEMINI_BASE_URL=http://127.0.0.1:8090/gemini
# TT_SLACK_BRIEF_CHANNEL=C0XXXXXXXXX   (channel ID; /techtrend only works here)
#
# Local hour (TT_DIGEST_TIMEZONE) for the day's briefs. Weekly fires on
# Monday and monthly on the 1st, from the same sweep.
TT_BRIEF_HOUR=18
#
# Grounding is billed per search the MODEL chooses to run, not per prompt --
# measured between 2 and 15 for one question. These are the stops on a bill
# that is otherwise shaped by the model's judgement.
TT_BRIEF_MAX_PER_DAY=40
TT_BRIEF_QUESTIONS_PER_DAY=10
TT_BRIEF_REPLIES_PER_DAY=30
#
# Gemini answers thread replies in the briefs channel WITHOUT being
# mentioned. Needs the message.groups (private) or message.channels (public)
# event subscription in the Slack app. Off by default: a bot that answers
# unprompted should be a decision, not a deploy.
TT_BRIEF_DISCUSS_ENABLED=false
