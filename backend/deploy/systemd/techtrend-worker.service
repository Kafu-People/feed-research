[Unit]
Description=TechTrend pipeline worker (collect, read, group, match, notify, digest)
After=network-online.target

[Service]
WorkingDirectory=/opt/TechTrend/backend
ExecStart=/opt/TechTrend/backend/.venv/bin/techtrend worker --stage collect,read,group,match,notify,digest,summarize,hourly,brief,discuss,maintenance --concurrency 4
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
