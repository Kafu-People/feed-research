# Production / staging template. Copy to backend/.env on the target host and
# fill every value marked REQUIRED. Never commit the result -- .env is
# gitignored, this file is not.
#
# Read docs/development/15-deployment.md for topology and
# backend/deploy/systemd/README.md for the units that consume this file.
#
# Two keys are NOT enough to deploy this. The pipeline will collect, judge and
# deliver nothing without the Slack block below -- see WHAT MAKES IT INERT at
# the bottom.

# --- environment ------------------------------------------------------------
# "staging" or "prod". The choice is load-bearing, not cosmetic:
# check_production_invariants() in platform/config.py refuses to boot prod if
#   - TT_AI_FAKE is true
#   - TT_JWT_SECRET is still "dev-secret"
#   - TT_RESPECT_ROBOTS is false
#   - TT_S3_ENDPOINT is set to ANYTHING
# That last one forbids MinIO outright. Use "prod" only with real S3 reached
# through the default credential chain (IAM role / instance profile). To keep
# the MinIO container from docker-compose.yml, run "staging".
TT_ENV=staging
TT_LOG_LEVEL=INFO

# --- storage ----------------------------------------------------------------
# REQUIRED. asyncpg driver here; alembic swaps in psycopg itself.
# The compose db binds 127.0.0.1 only, so localhost is correct on the host.
TT_DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/techtrend
TT_DATABASE_POOL_SIZE=10
TT_REDIS_URL=redis://localhost:6379/0

# Article bodies live in object storage, never in Postgres (invariant #1), and
# seven modules read them back. This is not optional plumbing.
TT_S3_BUCKET=techtrend
# staging + MinIO: point at the compose container and set both keys.
# prod: DELETE all three lines. Boot fails if the endpoint is set.
TT_S3_ENDPOINT=http://localhost:9000
TT_S3_ACCESS_KEY=CHANGEME
TT_S3_SECRET_KEY=CHANGEME

# --- auth -------------------------------------------------------------------
# REQUIRED. prod refuses to boot while this reads "dev-secret".
#   openssl rand -hex 32
TT_JWT_SECRET=CHANGEME

# --- crawler ----------------------------------------------------------------
# REQUIRED to change: a monitored contact address is a launch-checklist item
# and publishers are entitled to one that reaches a human.
TT_USER_AGENT=TechTrendBot/1.0 (+https://YOURDOMAIN/bot; bot@YOURDOMAIN)
# Capped at 2 by the field type. A larger value is a startup failure, by design.
TT_PER_HOST_CONCURRENCY=2
TT_RESPECT_ROBOTS=true

# --- ai keys ----------------------------------------------------------------
# NOT TT_-prefixed, either of them: both are declared with a validation_alias
# so they match the names the vendor SDKs read. TT_ANTHROPIC_API_KEY is
# silently ignored.
#
# REQUIRED. Judging and distilling return typed objects and stay on Claude
# regardless of TT_AI_WRITER, so this key is needed in every configuration.
ANTHROPIC_API_KEY=CHANGEME
# Required for the daily research briefs, and for prose when the writer is
# gemini. Omit it and the brief stages are inert.
GEMINI_API_KEY=CHANGEME

# REQUIRED. Must be false. Leaving the dev default behind is the single
# easiest way to deploy a system that looks healthy and calls no model.
TT_AI_FAKE=false

# Who writes the channel's prose -- summaries, digest, weekly, Q&A.
# "gemini" by operator decision 2026-09-23. Judging stays on Claude.
TT_AI_WRITER=gemini

# --- slack delivery (THE delivery surface) ----------------------------------
# REQUIRED unless you intend a pipeline that posts nowhere.
# Bot token from api.slack.com/apps -> OAuth & Permissions.
# Scopes: chat:write, chat:write.public, channels:read, channels:manage,
#         channels:history, app_mentions:read
TT_SLACK_BOT_TOKEN=xoxb-CHANGEME
TT_SLACK_CHANNEL=#techtrend-ai

# App-level token, Socket Mode -> generate, scope connections:write.
# techtrend-slackbot.service exits immediately without it. Needed because this
# host has no public HTTPS endpoint for Slack's Events API to POST to.
TT_SLACK_APP_TOKEN=xapp-CHANGEME

# Which topics reach Slack, by topic id. Ids come from seed-topics, so read
# them back before setting this:
#   SELECT id, title FROM topics ORDER BY id;
# REMOVE THE LINE ENTIRELY for every topic -- an empty list means "no filter",
# not "nothing".
TT_SLACK_TOPIC_IDS=[1,3,13,17,18]
TT_SLACK_MATCH_FLOOR=0.6
TT_SLACK_TOPIC_FLOORS={"18": 0.5}
TT_SLACK_DELIVERY_MODE=hourly
TT_SLACK_SUMMARIES=true

# --- research briefs --------------------------------------------------------
# Deliberately a different channel from TT_SLACK_CHANNEL: a brief should not
# compete with the hourly report. Inert unless the key AND this are both set.
TT_SLACK_BRIEF_CHANNEL=#techtrend-briefs
TT_BRIEF_HOUR=18
# Grounding is billed per search THE MODEL chooses to run (2-15 per question,
# $14/1,000 with 5,000/month free). These caps are the stops on that bill.
TT_BRIEF_MAX_PER_DAY=40
TT_BRIEF_QUESTIONS_PER_DAY=10
TT_BRIEF_REPLIES_PER_DAY=30
# Answers thread replies without being mentioned. Off unless you decide
# otherwise -- it also needs the message.groups/message.channels subscription.
TT_BRIEF_DISCUSS_ENABLED=false

# --- digest -----------------------------------------------------------------
TT_DIGEST_ENABLED=true
TT_DIGEST_HOUR=18
# An IANA zone, never a UTC offset.
TT_DIGEST_TIMEZONE=America/Sao_Paulo

# --- worker -----------------------------------------------------------------
# The unit passes --concurrency itself; this is the default for other entry
# points. Size against db max_connections (compose sets 200).
TT_WORKER_CONCURRENCY=4

# ----------------------------------------------------------------------------
# WHAT MAKES IT INERT -- each of these fails quietly, with no error anywhere:
#
#   TT_AI_FAKE=true             every model call returns a canned answer
#   no TT_SLACK_BOT_TOKEN       no notify job is ever enqueued
#   no TT_SLACK_CHANNEL         same -- BOTH are required, either missing
#   no GEMINI_API_KEY           brief stages skip
#   no TT_SLACK_BRIEF_CHANNEL   briefs are researched and posted nowhere
#   empty topics table          nothing to collect, nothing to match
#
# The database is empty after `alembic upgrade head`. Seed it:
#   .venv/bin/techtrend seed-topics && .venv/bin/techtrend seed-sites
# or restore ops/backup/*.sql from the db-backups branch.
