# React 19 (web) and React 18 (React Native) coexist in this workspace.
# Hoisting @types/* to the virtual store root makes TypeScript resolve the
# WRONG React types for one of them ("'Suspense' cannot be used as a JSX
# component"). Keep type packages package-local.
hoist-pattern[]=*
hoist-pattern[]=!@types/**
strict-peer-dependencies=false
