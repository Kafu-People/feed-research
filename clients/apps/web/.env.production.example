# Copy to clients/apps/web/.env.production on the target host.
#
# NEXT_PUBLIC_* is INLINED AT BUILD TIME, not read at runtime. Setting it after
# `pnpm build` changes nothing -- the old value is already compiled into the
# client bundle. So this file has to be in place BEFORE `make build-web`, and
# changing it means rebuilding, not restarting.
#
# src/lib/api.ts falls back to http://localhost:8000 when this is unset, which
# is why a misconfigured deploy looks fine until a browser that is not on the
# server tries to load the dashboard.
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN

# Same host, same parent domain as the web app: that keeps the refresh cookie
# first-party and removes CORS preflights entirely (docs/development/15-deployment.md).
# Serving the API from an unrelated domain breaks the refresh cookie.

# Port for `next start`. techtrend-web.service runs `pnpm start` with no --port,
# so Next uses this or 3000.
PORT=3000
